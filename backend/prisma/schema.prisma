// =====================================================================
//  Schéma Prisma — Gestion de transport & logistique (Multi-Tenant)
//  Mappé sur la base PostgreSQL validée.
//  Les colonnes calculées par la base (GENERATED ... STORED) sont déclarées
//  optionnelles et signalées « lecture seule » : ne jamais les écrire depuis
//  l'application (la base les calcule). Voir les commentaires /// sur chaque champ.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------- ENUMS -------------------------

enum CompanyStatut {
  ACTIF
  INACTIF
  SUSPENDU

  @@map("company_statut")
}

enum UserStatut {
  ACTIF
  INACTIF
  SUSPENDU

  @@map("user_statut")
}

enum ClientStatut {
  ACTIF
  INACTIF
  BLOQUE

  @@map("client_statut")
}

enum ConducteurStatut {
  DISPONIBLE
  EN_VOYAGE
  INDISPONIBLE
  INACTIF

  @@map("conducteur_statut")
}

enum VehiculeStatut {
  DISPONIBLE
  EN_VOYAGE
  MAINTENANCE
  HORS_SERVICE

  @@map("vehicule_statut")
}

enum DocumentStatut {
  VALIDE
  BIENTOT_EXPIRE
  EXPIRE

  @@map("document_statut")
}

enum VoyageType {
  NATIONAL
  INTERNATIONAL
  IMPORT
  EXPORT

  @@map("voyage_type")
}

enum VoyageStatut {
  PLANIFIE
  EN_COURS
  LIVRE
  ANNULE
  FACTURE

  @@map("voyage_statut")
}

enum PaiementMethode {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE
  EFFET
  PRELEVEMENT

  @@map("paiement_methode")
}

enum CreanceStatut {
  NON_PAYE
  PARTIEL
  PAYE
  EN_RETARD

  @@map("creance_statut")
}

enum DetteStatut {
  OUVERTE
  PARTIELLE
  SOLDEE
  EN_RETARD

  @@map("dette_statut")
}

enum GestionStatut {
  EN_ATTENTE
  PAYE
  EN_RETARD
  ANNULE

  @@map("gestion_statut")
}

enum EmployeStatut {
  ACTIF
  SUSPENDU
  DEMISSIONNAIRE
  LICENCIE
  RETRAITE
  INACTIF

  @@map("employe_statut")
}

enum ContratType {
  CDI
  CDD
  STAGE
  TEMPORAIRE
  FREELANCE

  @@map("contrat_type")
}

enum PaiementModeEmploye {
  VIREMENT
  ESPECES
  CHEQUE

  @@map("paiement_mode_employe")
}

enum VersementEmployeType {
  SALAIRE
  PRIME
  GLOBAL

  @@map("versement_employe_type")
}

// ------------------------- MODELS -------------------------

model Company {
  id          Int           @id @default(autoincrement())
  nom         String        @db.VarChar(150)
  statut      CompanyStatut @default(ACTIF)
  creeLe      DateTime      @default(now()) @map("cree_le") @db.Timestamptz(6)
  misAJourLe  DateTime      @default(now()) @updatedAt @map("mis_a_jour_le") @db.Timestamptz(6)

  users                        User[]
  companySettings              CompanySettings?
  clients                      Client[]
  fournisseurs                 Fournisseur[]
  employes                     Employe[]
  vehicules                    Vehicule[]
  conducteurs                  Conducteur[]
  voyages                      Voyage[]
  factures                     Facture[]
  depensesAdministratives      DepenseAdministrative[]
  gestionPaiements             GestionPaiement[]
  dettesFournisseurs           DetteFournisseur[]
  invoiceSequences             InvoiceSequence[]
  detteFournisseurSequences    DetteFournisseurSequence[]
  paiementFournisseurSequences PaiementFournisseurSequence[]
  employeSequences             EmployeSequence[]
  paiementEmployeSequences     PaiementEmployeSequence[]
  customRoles                  Role[]

  @@map("companies")
}

model Role {
  id          Int     @id @default(autoincrement())
  companyId   Int?    @map("company_id")
  nom         String  @db.VarChar(50)
  description String? @db.VarChar(255)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users   User[]

  @@index([companyId])
  @@map("roles")
}

model User {
  id                Int         @id @default(autoincrement())
  companyId         Int         @map("company_id")
  nom               String      @db.VarChar(120)
  email             String      @unique @db.Citext
  telephone         String?     @db.VarChar(30)
  motDePasse        String      @map("mot_de_passe") @db.VarChar(255)
  idRole            Int         @map("id_role")
  statut            UserStatut  @default(ACTIF)
  permissions       Json?
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  derniereConnexion DateTime?   @map("derniere_connexion") @db.Timestamptz(6)
  creeLe            DateTime    @default(now()) @map("cree_le") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  role     Role      @relation(fields: [idRole], references: [id], onUpdate: Cascade, onDelete: Restrict)
  factures Facture[]
  dettesCrees DetteFournisseur[] @relation("DetteAuteur")
  paiementsCrees PaiementFournisseur[] @relation("PaiementAuteur")
  paiementsAnnules PaiementFournisseur[] @relation("PaiementAnnulateur")
  depensesAdministrativesCrees DepenseAdministrative[] @relation("DepenseAdminAuteur")

  @@index([companyId])
  @@index([idRole])
  @@index([statut])
  @@map("users")
}

model Client {
  id                 Int           @id @default(autoincrement())
  companyId          Int           @map("company_id")
  nomEntreprise      String        @map("nom_entreprise") @db.VarChar(150)
  ice                String?       @db.VarChar(15)
  telephone          String?       @db.VarChar(30)
  email              String?       @db.Citext
  adresse            String?       @db.VarChar(255)
  delaiPaiementJours Int           @default(30) @map("delai_paiement_jours")
  limiteCredit       Decimal       @default(0) @map("limite_credit") @db.Decimal(14, 2)
  statut             ClientStatut  @default(ACTIF)
  deviseFacturation  String        @default("MAD") @map("devise_facturation") @db.VarChar(3)

  company Company  @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  voyages Voyage[]

  @@unique([companyId, ice])
  @@index([companyId])
  @@index([nomEntreprise])
  @@index([statut])
  @@map("clients")
}

model Conducteur {
  id            Int               @id @default(autoincrement())
  companyId     Int               @map("company_id")
  nomConducteur String            @map("nom_conducteur") @db.VarChar(150)
  telephone     String?           @db.VarChar(30)
  adresse       String?           @db.VarChar(255)
  statut        ConducteurStatut  @default(DISPONIBLE)
  creeLe        DateTime          @default(now()) @map("cree_le") @db.Timestamptz(6)
  idEmploye     Int?              @unique @map("id_employe")

  company   Company   @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  employe   Employe?  @relation(fields: [idEmploye], references: [id], onUpdate: Cascade, onDelete: SetNull)
  documents DocumentConducteur[]

  @@index([companyId])
  @@index([nomConducteur])
  @@index([statut])
  @@map("conducteurs")
}

model Vehicule {
  id             Int             @id @default(autoincrement())
  companyId      Int             @map("company_id")
  immatriculation String         @unique @db.VarChar(20)
  marque         String          @db.VarChar(60)
  modele         String?         @db.VarChar(60)
  typeVehicule   String          @default("CAMION") @map("type_vehicule") @db.VarChar(40)
  annee          Int?            @db.SmallInt
  numeroChassis  String?         @map("numero_chassis") @db.VarChar(50)
  capaciteCharge Decimal?        @map("capacite_charge") @db.Decimal(8, 2)
  statut         VehiculeStatut  @default(DISPONIBLE)
  creeLe         DateTime        @default(now()) @map("cree_le") @db.Timestamptz(6)

  company          Company            @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  documents        DocumentVehicule[]
  bonsCarburant    BonCarburant[]
  depenses         DepenseVehicule[]
  voyagesTracteur  Voyage[]           @relation("VoyageTracteur")
  voyagesRemorque  Voyage[]           @relation("VoyageRemorque")

  @@unique([companyId, immatriculation])
  @@unique([companyId, numeroChassis])
  @@index([companyId])
  @@index([statut])
  @@index([typeVehicule])
  @@map("vehicules")
}

model DocumentVehicule {
  idDocument        Int            @id @default(autoincrement()) @map("id_document")
  immatriculation   String         @db.VarChar(20)
  typeDocument      String         @map("type_document") @db.VarChar(50)
  numeroDocument    String?        @map("numero_document") @db.VarChar(60)
  organismeEmetteur String?        @map("organisme_emetteur") @db.VarChar(100)
  dateEmission      DateTime?      @map("date_emission") @db.Date
  dateExpiration    DateTime?      @map("date_expiration") @db.Date
  statut            DocumentStatut @default(VALIDE)
  cheminFichier     String?        @map("chemin_fichier") @db.VarChar(500)
  nomOriginal       String?        @map("nom_original") @db.VarChar(255)
  mimeType          String?        @map("mime_type") @db.VarChar(100)
  tailleFichier     BigInt?        @map("taille_fichier")
  notes             String?        @db.VarChar(255)
  creeLe            DateTime       @default(now()) @map("cree_le") @db.Timestamptz(6)
  misAJourLe        DateTime       @default(now()) @map("mis_a_jour_le") @db.Timestamptz(6)
  supprimeLe        DateTime?      @map("supprime_le") @db.Timestamptz(6)

  vehicule Vehicule @relation(fields: [immatriculation], references: [immatriculation], onUpdate: Cascade, onDelete: Cascade)

  @@index([immatriculation])
  @@index([dateExpiration])
  @@index([supprimeLe])
  @@map("documents_vehicules")
}

model DocumentConducteur {
  id             Int             @id @default(autoincrement())
  idConducteur   Int             @map("id_conducteur")
  typeDocument   String          @map("type_document") @db.VarChar(50)
  numeroDocument String?         @map("numero_document") @db.VarChar(60)
  dateEmission   DateTime?       @map("date_emission") @db.Date
  dateExpiration DateTime?       @map("date_expiration") @db.Date
  cheminFichier  String?         @map("chemin_fichier") @db.VarChar(500)
  statut         DocumentStatut  @default(VALIDE)
  notes          String?         @db.VarChar(255)
  creeLe         DateTime        @default(now()) @map("cree_le") @db.Timestamptz(6)
  misAJourLe     DateTime        @default(now()) @map("mis_a_jour_le") @db.Timestamptz(6)

  conducteur Conducteur @relation(fields: [idConducteur], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([idConducteur])
  @@index([dateExpiration])
  @@index([statut])
  @@map("documents_conducteurs")
}

model Voyage {
  idVoyage         Int           @id @default(autoincrement()) @map("id_voyage")
  companyId        Int           @map("company_id")
  idClient         Int?          @map("id_client")
  typeVoyage       VoyageType    @default(NATIONAL) @map("type_voyage")
  tracteur         String?       @db.VarChar(20)
  remorque         String?       @db.VarChar(20)
  nomConducteur    String?       @map("nom_conducteur") @db.VarChar(150)
  nomClient        String?       @map("nom_client") @db.VarChar(150)
  lieuChargement   String        @map("lieu_chargement") @db.VarChar(150)
  lieuDechargement String        @map("lieu_dechargement") @db.VarChar(150)
  dateChargement   DateTime?     @map("date_chargement") @db.Date
  numeroCmr        String?       @map("numero_cmr") @db.VarChar(50)
  statut           VoyageStatut  @default(PLANIFIE)
  montantVoyage    Decimal       @default(0) @map("montant_voyage") @db.Decimal(14, 2)
  devise           String        @default("MAD") @db.VarChar(3)

  company          Company       @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  client           Client?       @relation(fields: [idClient], references: [id], onDelete: SetNull)
  tracteurVehicule Vehicule?     @relation("VoyageTracteur", fields: [tracteur], references: [immatriculation], onUpdate: Cascade, onDelete: SetNull)
  remorqueVehicule Vehicule?     @relation("VoyageRemorque", fields: [remorque], references: [immatriculation], onUpdate: Cascade, onDelete: SetNull)
  factures         Facture[]

  @@index([companyId])
  @@index([idClient])
  @@index([statut])
  @@index([nomClient])
  @@index([nomConducteur])
  @@index([tracteur])
  @@index([dateChargement])
  @@map("voyages")
}

model BonCarburant {
  idBon           Int       @id @default(autoincrement()) @map("id_bon")
  numeroBon       String?   @map("numero_bon") @db.VarChar(50)
  immatriculation String    @db.VarChar(20)
  nomConducteur   String?   @map("nom_conducteur") @db.VarChar(150)
  nomStation      String?   @map("nom_station") @db.VarChar(120)
  kilometrage     BigInt?   @map("kilometrage")
  litres          Decimal   @db.Decimal(10, 2)
  prixParLitre    Decimal   @map("prix_par_litre") @db.Decimal(10, 3)
  /// Colonne générée par la base (montant_total = litres × prix_par_litre) — lecture seule.
  montantTotal    Decimal?  @map("montant_total") @db.Decimal(14, 2)
  dateCarburant   DateTime  @default(now()) @map("date_carburant") @db.Date

  vehicule Vehicule @relation(fields: [immatriculation], references: [immatriculation], onUpdate: Cascade, onDelete: Restrict)

  @@index([immatriculation])
  @@index([dateCarburant])
  @@index([kilometrage])
  @@map("bons_carburant")
}

enum JustificatifType {
  AVEC_FACTURE
  SANS_FACTURE
}

model DepenseVehicule {
  idDepense        Int              @id @default(autoincrement()) @map("id_depense")
  categorieDepense String           @map("categorie_depense") @db.VarChar(60)
  justificatifType JustificatifType @default(AVEC_FACTURE) @map("justificatif_type")
  typeFacture      String?          @map("type_facture") @db.VarChar(40)
  immatriculation  String           @db.VarChar(20)
  description      String?          @db.VarChar(255)
  fichierRecu      String?          @map("fichier_recu") @db.VarChar(500)
  montant          Decimal          @db.Decimal(14, 2)
  dateDepense      DateTime         @default(now()) @map("date_depense") @db.Date

  vehicule Vehicule @relation(fields: [immatriculation], references: [immatriculation], onUpdate: Cascade, onDelete: Restrict)

  @@index([immatriculation])
  @@index([categorieDepense])
  @@index([dateDepense])
  @@map("depenses_vehicules")
}

model DepenseAdministrative {
  idDepense        Int       @id @default(autoincrement()) @map("id_depense")
  companyId        Int       @map("company_id")
  categorieDepense String    @map("categorie_depense") @db.VarChar(60)
  description      String?   @db.VarChar(255)
  fichierRecu      String?   @map("fichier_recu") @db.VarChar(500)
  montant          Decimal   @db.Decimal(14, 2)
  dateDepense      DateTime  @default(now()) @map("date_depense") @db.Date
  creePar          Int?      @map("cree_par")
  creeLe           DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  misAJourLe       DateTime  @default(now()) @updatedAt @map("mis_a_jour_le") @db.Timestamptz(6)
  supprimeLe       DateTime? @map("supprime_le") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  auteur  User?   @relation("DepenseAdminAuteur", fields: [creePar], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@index([companyId])
  @@index([categorieDepense])
  @@index([dateDepense])
  @@index([supprimeLe])
  @@map("depenses_administratives")
}

model Facture {
  id               Int       @id @default(autoincrement())
  companyId        Int       @map("company_id")
  numeroFacture    String    @unique @map("numero_facture") @db.VarChar(30)
  nomClient        String    @map("nom_client") @db.VarChar(150)
  idVoyage         Int?      @map("id_voyage")
  dateFacture      DateTime  @default(now()) @map("date_facture") @db.Date
  joursEcheance    Int       @default(30) @map("jours_echeance")
  /// Colonne générée (date_facture + jours_echeance) — lecture seule.
  dateEcheance     DateTime? @map("date_echeance") @db.Date
  devise           String    @default("MAD") @db.VarChar(3)
  sousTotal        Decimal   @default(0) @map("sous_total") @db.Decimal(14, 2)
  tauxTva          Decimal   @default(20.00) @map("taux_tva") @db.Decimal(5, 2)
  /// Colonnes générées (TVA et TTC) — lecture seule.
  montantTva       Decimal?  @map("montant_tva") @db.Decimal(14, 2)
  montantTotal     Decimal?  @map("montant_total") @db.Decimal(14, 2)
  montantEnLettres String?   @map("montant_en_lettres") @db.VarChar(255)
  cheminPdf        String?   @map("chemin_pdf") @db.VarChar(500)
  notes            String?   @db.VarChar(500)
  fichierJoint     String?   @map("fichier_joint") @db.VarChar(500)
  creePar          Int?      @map("cree_par")
  creeLe           DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  misAJourLe       DateTime  @default(now()) @map("mis_a_jour_le") @db.Timestamptz(6)
  supprimeLe       DateTime? @map("supprime_le") @db.Timestamptz(6)

  company   Company          @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  voyage    Voyage?          @relation(fields: [idVoyage], references: [idVoyage], onUpdate: Cascade, onDelete: SetNull)
  auteur    User?            @relation(fields: [creePar], references: [id], onUpdate: Cascade, onDelete: SetNull)
  creance   CreanceClient?
  paiements PaiementClient[]

  @@unique([companyId, numeroFacture])
  @@index([companyId])
  @@index([nomClient])
  @@index([idVoyage])
  @@index([dateEcheance])
  @@index([supprimeLe])
  @@map("factures")
}

model CreanceClient {
  id                 Int            @id @default(autoincrement())
  numeroFacture      String         @unique @map("numero_facture") @db.VarChar(30)
  dateEmission       DateTime       @default(now()) @map("date_emission") @db.Date
  nomClient          String         @map("nom_client") @db.VarChar(150)
  delaiPaiementJours Int            @default(30) @map("delai_paiement_jours")
  montantFacture     Decimal        @map("montant_facture") @db.Decimal(14, 2)
  montantRecu        Decimal        @default(0) @map("montant_recu") @db.Decimal(14, 2)
  /// Colonne générée (montant_facture − montant_recu) — lecture seule.
  solde              Decimal?       @db.Decimal(14, 2)
  dateEcheance       DateTime?      @map("date_echeance") @db.Date
  statutPaiement     CreanceStatut  @default(NON_PAYE) @map("statut_paiement")
  actionRecouvrement String?        @map("action_recouvrement") @db.VarChar(255)
  devise             String         @default("MAD") @db.VarChar(3)

  facture Facture @relation(fields: [numeroFacture], references: [numeroFacture], onUpdate: Cascade, onDelete: Cascade)

  @@index([nomClient])
  @@index([statutPaiement])
  @@map("creances_clients")
}

model PaiementClient {
  id              Int              @id @default(autoincrement())
  numeroFacture   String           @map("numero_facture") @db.VarChar(30)
  nomClient       String           @map("nom_client") @db.VarChar(150)
  datePaiement    DateTime         @default(now()) @map("date_paiement") @db.Date
  montantRecu     Decimal          @map("montant_recu") @db.Decimal(14, 2)
  methodePaiement PaiementMethode  @map("methode_paiement")
  devise          String           @default("MAD") @db.VarChar(3)
  tauxChange          Decimal?  @map("taux_change") @db.Decimal(18, 6)
  montantConvertiMad  Decimal?  @map("montant_converti_mad") @db.Decimal(14, 2)
  sourceTaux          String?   @map("source_taux") @db.VarChar(50)
  estTauxManuel       Boolean   @default(false) @map("est_taux_manuel")
  dateTauxUtilise     DateTime? @map("date_taux_utilise") @db.Date

  facture Facture @relation(fields: [numeroFacture], references: [numeroFacture], onUpdate: Cascade, onDelete: Restrict)
  lettreDeChange  LettreDeChange?

  @@index([numeroFacture])
  @@index([nomClient])
  @@index([datePaiement])
  @@map("paiements_clients")
}

model Fournisseur {
  id              Int           @id @default(autoincrement())
  companyId       Int           @map("company_id")
  nomFournisseur  String        @map("nom_fournisseur") @db.VarChar(150)
  ice             String?       @db.VarChar(15)
  telephone       String?       @db.VarChar(30)
  email           String?       @db.Citext
  adresse         String?       @db.VarChar(255)
  statut          ClientStatut  @default(ACTIF)
  creeLe          DateTime      @default(now()) @map("cree_le") @db.Timestamptz(6)

  company Company           @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  dettes  DetteFournisseur[]

  @@unique([companyId, nomFournisseur])
  @@unique([companyId, ice])
  @@index([companyId])
  @@index([statut])
  @@map("fournisseurs")
}

model DetteFournisseur {
  id                          Int       @id @default(autoincrement())
  companyId                   Int       @map("company_id")
  numeroDette                 String    @map("numero_dette") @db.VarChar(30)
  referenceFactureFournisseur String?   @map("reference_facture_fournisseur") @db.VarChar(60)
  idFournisseur               Int       @map("id_fournisseur")
  nomFournisseurSnapshot      String    @map("nom_fournisseur_snapshot") @db.VarChar(150)
  categorie                   String?   @db.VarChar(60)
  dateDette                   DateTime  @default(now()) @map("date_dette") @db.Date
  delaiPaiementJours          Int       @default(30) @map("delai_paiement_jours")
  dateEcheance                DateTime  @map("date_echeance") @db.Date
  montantDu                   Decimal   @map("montant_du") @db.Decimal(14, 2)
  remarques                   String?   @db.VarChar(500)
  creeParId                   Int?      @map("cree_par_id")
  creeLe                      DateTime  @default(now()) @map("cree_le") @db.Timestamptz(6)
  misAJourLe                  DateTime  @default(now()) @updatedAt @map("mis_a_jour_le") @db.Timestamptz(6)
  supprimeLe                  DateTime? @map("supprime_le") @db.Timestamptz(6)

  company     Company               @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  fournisseur Fournisseur           @relation(fields: [idFournisseur], references: [id], onUpdate: Cascade, onDelete: Restrict)
  auteur      User?                 @relation("DetteAuteur", fields: [creeParId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  paiements   PaiementFournisseur[]

  @@unique([companyId, numeroDette])
  @@index([companyId])
  @@index([idFournisseur])
  @@index([dateEcheance])
  @@index([supprimeLe])
  @@map("dettes_fournisseurs")
}

model PaiementFournisseur {
  id                 Int             @id @default(autoincrement())
  numeroPaiement     String          @unique @map("numero_paiement") @db.VarChar(30)
  idDetteFournisseur Int             @map("id_dette_fournisseur")
  montant            Decimal         @db.Decimal(14, 2)
  datePaiement       DateTime        @default(now()) @map("date_paiement") @db.Date
  modePaiement       PaiementMethode @map("mode_paiement")
  referenceExterne   String?         @map("reference_externe") @db.VarChar(80)
  notes              String?         @db.VarChar(500)
  estAnnule          Boolean         @default(false) @map("est_annule")
  dateAnnulation     DateTime?       @map("date_annulation") @db.Timestamptz(6)
  motifAnnulation    String?         @map("motif_annulation") @db.VarChar(255)
  annuleParId        Int?            @map("annule_par_id")
  creeParId          Int?            @map("cree_par_id")
  creeLe             DateTime        @default(now()) @map("cree_le") @db.Timestamptz(6)
  misAJourLe         DateTime        @default(now()) @updatedAt @map("mis_a_jour_le") @db.Timestamptz(6)

  detteFournisseur DetteFournisseur @relation(fields: [idDetteFournisseur], references: [id], onUpdate: Cascade, onDelete: Restrict)
  lettreDeChange  LettreDeChange?
  auteur           User?            @relation("PaiementAuteur", fields: [creeParId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  annulePar        User?            @relation("PaiementAnnulateur", fields: [annuleParId], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@index([idDetteFournisseur])
  @@index([datePaiement])
  @@index([estAnnule])
  @@map("paiements_fournisseurs")
}

