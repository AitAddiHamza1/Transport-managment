model Employe {
  id                Int                  @id @default(autoincrement())
  companyId         Int                  @map("company_id")
  matricule         String               @db.VarChar(30)
  nom               String               @db.VarChar(100)
  prenom            String               @db.VarChar(100)
  cin               String?              @db.VarChar(30)
  dateNaissance     DateTime?            @map("date_naissance") @db.Date
  telephone         String?              @db.VarChar(30)
  email             String?              @db.Citext
  adresse           String?              @db.VarChar(255)
  poste             String               @db.VarChar(100)
  departement       String?              @db.VarChar(100)
  dateEmbauche      DateTime             @map("date_embauche") @db.Date
  typeContrat       ContratType          @map("type_contrat")
  statut            EmployeStatut        @default(ACTIF)
  dateSortie        DateTime?            @map("date_sortie") @db.Date
  motifSortie       String?              @map("motif_sortie") @db.VarChar(255)
  salaireBase       Decimal?             @map("salaire_base") @db.Decimal(14, 2)
  modePaiement      PaiementModeEmploye? @map("mode_paiement")
  nomBanque         String?              @map("nom_banque") @db.VarChar(100)
  rib               String?              @db.VarChar(34)
  photoFilename     String?              @map("photo_filename") @db.VarChar(255)
  photoOriginalName String?              @map("photo_original_name") @db.VarChar(255)
  photoMimeType     String?              @map("photo_mime_type") @db.VarChar(100)
  photoSize         Int?                 @map("photo_size")
  photoPath         String?              @map("photo_path") @db.VarChar(500)
  observations      String?              @db.VarChar(500)
  creeLe            DateTime             @default(now()) @map("cree_le") @db.Timestamptz(6)
  misAJourLe        DateTime             @default(now()) @map("mis_a_jour_le") @db.Timestamptz(6)
  supprimeLe        DateTime?            @map("supprime_le") @db.Timestamptz(6)

  company    Company           @relation(fields: [companyId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  documents  DocumentEmploye[]
  paiements  PaiementEmploye[]
  conducteur Conducteur?

  @@unique([companyId, matricule])
  @@index([companyId])
  @@index([nom, prenom])
  @@index([statut])
  @@index([departement])
  @@index([poste])
  @@index([supprimeLe])
  @@map("employes")
}

model DocumentEmploye {
  id             Int            @id @default(autoincrement())
  idEmploye      Int            @map("id_employe")
  typeDocument   String         @map("type_document") @db.VarChar(50)
  numeroDocument String?        @map("numero_document") @db.VarChar(60)
  dateEmission   DateTime?      @map("date_emission") @db.Date
