  filename       String         @db.VarChar(255)
  originalName   String         @map("original_name") @db.VarChar(255)
  mimeType       String         @map("mime_type") @db.VarChar(100)
  fileSize       Int            @map("file_size")
  cheminFichier  String         @map("chemin_fichier") @db.VarChar(500)
  statut         DocumentStatut @default(VALIDE)
  notes          String?        @db.VarChar(255)
  creeLe         DateTime       @default(now()) @map("cree_le") @db.Timestamptz(6)
  misAJourLe     DateTime       @default(now()) @map("mis_a_jour_le") @db.Timestamptz(6)

  employe Employe @relation(fields: [idEmploye], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([idEmploye])
  @@index([typeDocument])
  @@index([dateExpiration])
  @@index([statut])
  @@map("documents_employes")
}

